# =============================================================================
# Contoh konfigurasi. Salin jadi .env lalu sesuaikan:
#   cp backend/.env.example backend/.env
#
# PENTING soal PATH: beberapa nilai di bawah memakai path absolut
# /home/ROG/MyAssistant (lokasi repo penulis). Ganti dengan lokasi repo Anda di:
#   - AI_SYSTEM_PROMPT  (folder output + perintah konversi PDF)
#   - HERMES_OUTPUT_HOST
# tools/topdf.sh otomatis mengikuti lokasi repo. docker-compose tidak me-mount
# seluruh home directory; dari home hanya $HOME/.hermes (read-only).
# =============================================================================

APP_NAME="Local AI Chat Assistant"
APP_ENV=local
# Kosongkan lalu isi hasil perintah berikut:
#   docker compose run --rm backend php artisan key:generate --show
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=Asia/Makassar
APP_URL=http://localhost:8000

LOG_CHANNEL=stack
LOG_LEVEL=debug

# Session/cache berbasis file; antrean memakai database agar job berat
# (STT, pembuatan dokumen) dijalankan oleh container `queue-worker` terpisah.
SESSION_DRIVER=file
CACHE_STORE=file
QUEUE_CONNECTION=database
# Harus lebih besar dari --timeout worker (3600) agar job tidak di-retry saat masih jalan.
DB_QUEUE_RETRY_AFTER=3660
BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local

# ---------------------------------------------------------------------------
# Gateway AI lokal (API kompatibel OpenAI).
# "host.docker.internal" = mesin host dilihat dari dalam container.
#   Hermes    : http://host.docker.internal:8642/v1/chat/completions
#   LM Studio : http://host.docker.internal:1234/v1/chat/completions
#   Ollama    : http://host.docker.internal:11434/v1/chat/completions
# ---------------------------------------------------------------------------
AI_API_URL=http://host.docker.internal:8642/v1/chat/completions
AI_API_KEY=change-me-local-dev
AI_MODEL=hermes-agent
AI_SYSTEM_PROMPT="You are Hermes, a helpful, concise and friendly AI assistant. Whenever a request involves producing or processing a file (document, spreadsheet, presentation, PDF, image, code, report), you MUST send that file to the user by saving it and reporting it. Save it into the folder /home/ROG/MyAssistant/backend/storage/app/private/hermes-output, then include in your reply exactly one line per file: MEDIA: /home/ROG/MyAssistant/backend/storage/app/private/hermes-output/<filename>. Never claim you cannot send files — saving plus the MEDIA: line is how you send them. The app only imports files from that folder, so do not rely on other paths. The web app supports EVERY file type (PDF, DOCX, XLSX, PPTX, TXT, images, ZIP, etc.): every MEDIA: line becomes a download button in the chat, so never ask the user to open a filesystem path or copy files manually. To produce a PDF from a document (docx, pptx, xlsx, txt, md), run this exact command in the terminal: /home/ROG/MyAssistant/tools/topdf.sh <absolute-path-inside-storage/app> — it prints the absolute path of the generated PDF. Then include MEDIA: <that pdf path>. Always use this command when the user asks for a PDF."
# Folder host tempat agent menulis berkas hasil; container memetakannya ke storage-nya.
HERMES_OUTPUT_HOST=/home/ROG/MyAssistant/backend/storage/app/private/hermes-output
AI_TIMEOUT=600
AI_TEMPERATURE=0.7

# ---------------------------------------------------------------------------
# Text-to-speech (Piper, lokal di image backend). Model default (id_ID) sudah
# di-bake ke image. Folder di bawah dipakai untuk model suara tambahan:
# taruh <nama>.onnx + <nama>.onnx.json di situ, lalu restart backend.
# ---------------------------------------------------------------------------
TTS_ENGINE=piper
TTS_MODEL_PATH=/app/storage/app/tts_models

# Daftar origin CORS dipisah koma ("*" = izinkan semua).
CORS_ALLOWED_ORIGINS=*
